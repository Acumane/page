bren.page {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# Media file operations (JSON listings, downloads, thumbnails)
	handle_path /media/* {
		root * "/home/bren/Storage/Movies & TV"

		@json header Accept application/json
		@tailnet remote_ip 100.64.0.0/10

		handle @json {
			handle @tailnet {
				file_server browse
			}
			handle {
				respond 403
			}
		}

		@realFile file {path}
		handle @realFile {
			handle @tailnet {
				file_server
			}
			handle {
				respond 403
			}
		}

		# Not a real file — SPA fallback
		handle {
			root * /home/bren/proj/page/dist
			rewrite * /index.html
			file_server
		}
	}

	# SPA (home + client-side routes)
	handle {
		root * /home/bren/proj/page/dist
		try_files {path} /index.html
		file_server
	}
}

media.bren.page {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	redir * https://bren.page/media{uri} permanent
}
